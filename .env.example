# Dealer Quote Manager - configuration serveur

APP_ENV=local
APP_NAME=Dealer Quote Manager
APP_VERSION=serveur-v1

# URL publique future
PUBLIC_URL=http://127.0.0.1:8001

# Sécurité
SECRET_KEY=change-me-in-production

# Base de données
# Local actuel possible :
DATABASE_URL=sqlite:///data/dealer_quote_manager.sqlite

# Futur serveur PostgreSQL exemple :
# DATABASE_URL=postgresql://user:password@localhost:5432/dealer_quote_manager

# Stockage fichiers
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
PDF_DIR=storage/pdf
LOGO_DIR=storage/logos
CONTRACT_DIR=storage/contracts
SIGNED_DIR=storage/signed
BACKUP_DIR=storage/backups

# Feedback
FEEDBACK_DIR=data/feedback
FEEDBACK_WEBHOOK_FILE=data/feedback_webhook_url.txt
